# Copy this file to `.env` and fill in your values.
# The server automatically loads `artifacts/api-server/.env` on startup.

# --- Server ---
# PORT=5000
# BASE_PATH=
# API_URL=

# --- AI (Gemini by default; any OpenAI-compatible provider works) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini OpenAI-compatible endpoint (default)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# gemini-3.1-flash-lite is the verified free-tier default; 2.5-flash is no
# longer available to new accounts.
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Swap to DeepSeek (or OpenAI) instead ---
# GEMINI_BASE_URL=https://api.deepseek.com/v1
# GEMINI_MODEL=deepseek-chat
